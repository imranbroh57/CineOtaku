# ---------------------------------------------------------------
# CineOtaku environment variables
# Set these in: Vercel -> Project -> Settings -> Environment Variables
# For local development copy this file to .env.local (never commit it).
# ---------------------------------------------------------------

# --- PRIVATE (server only: read by /api/tmdb.js, never sent to the browser) ---
# TMDb "API Read Access Token" (the long JWT-style value, NOT the short API key)
# https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=

# --- PUBLIC (safe for browsers; served by /api/config.js) ---
# Supabase -> Project Settings -> API (or "API Keys")
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" key. RLS protects the data.
SUPABASE_PUBLISHABLE_KEY=

# Set to "true" ONLY after you enabled the Google provider in Supabase Auth.
# When not "true", the Google button is hidden (no dead buttons).
GOOGLE_AUTH_ENABLED=false

# !!! NEVER add SUPABASE_SERVICE_ROLE_KEY (or any sb_secret_ key) to this project.
# !!! The app does not need it, and /api/config.js refuses to publish a secret key.
